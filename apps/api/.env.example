DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_spedytor?schema=public"

# Required, min. 32 chars — the API refuses to start without it (no fallback,
# no placeholder). Generate: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
# Not used: refresh tokens are random UUIDs stored in the database.
JWT_REFRESH_SECRET=""

# Required: 64 hex chars = 32 bytes AES-256 key; all zeros is rejected.
# The seed needs the same key. Generate: openssl rand -hex 32
# Changing it on an existing database makes encrypted data (emails, names) unreadable.
ENCRYPTION_KEY=""

PORT=3001
FRONTEND_URL="http://localhost:3000"
# Only an explicit "development" or "test" lets the seed run and turns Swagger
# and registration on without their flags; no NODE_ENV (or production,
# staging…) counts as production.
NODE_ENV="development"
# Swagger (/api/docs and the JSON spec): off unless NODE_ENV is development/test
# or this is "true" (no key, all or nothing).
SWAGGER_ENABLED=""
# POST /api/auth/register (a new company with its ADMIN, no invitation): off
# unless NODE_ENV is development/test or this is "true". The first company on a
# server: npm run company:create (docs/DEPLOYMENT.md).
REGISTRATION_ENABLED=""

# AI Email Agent (optional — empty = rule-based classifier only).
# Any non-empty value counts as a key: a placeholder would send every e-mail
# to Anthropic and fall back to the rules only after a 401.
ANTHROPIC_API_KEY=""

# Nominatim (offer geocoding) — its usage policy requires a contact in the User-Agent
NOMINATIM_CONTACT_EMAIL=""

# Sentry (optional): errors 5xx and slow requests; empty = off.
SENTRY_DSN=""

# Trans.eu (optional): OAuth sign-in and publishing freights; empty = off
# (connect answers 400, health shows "not_configured").
TRANS_EU_CLIENT_ID=""
TRANS_EU_CLIENT_SECRET=
TRANS_EU_API_KEY=""
# The public address of this API — the OAuth callback is built from it;
# https:// makes the sign-in cookie Secure. Example: https://api.example.com
API_BASE_URL=""
