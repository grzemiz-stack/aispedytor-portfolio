{
  "name": "@aispedytor/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma migrate resolve --rolled-back 20260312000000_vehicle_category_trailers 2>/dev/null || true && prisma migrate deploy && node dist/main.js",
    "lint": "eslint --rulesdir eslint-rules --max-warnings 0 \"{src,apps,libs,test}/**/*.ts\"",
    "pretest": "prisma generate",
    "test": "jest",
    "test:future": "jest -c jest.future.config.js",
    "test:demo": "bash ../../tools/demo-test.sh",
    "company:create": "node dist/cli/create-company.js",
    "offers:recompute-economics": "node dist/cli/recompute-economics.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
